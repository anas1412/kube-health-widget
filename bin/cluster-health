#!/usr/bin/env bash
# Checks every cluster in ~/.config/cluster-health/clusters, writes ~/.cache/cluster-health/status.json
# and notifies (desktop, Telegram, Slack, Mattermost, Discord) on changes.
#   cluster-health          run one check
#   cluster-health --test   send a test message to every configured target
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/cluster-health"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/cluster-health"
mkdir -p "$CONF" "$CACHE"
[ -f "$CONF/clusters" ] || echo "${KUBECONFIG:-$HOME/.kube/config}" > "$CONF/clusters"
[ -f "$CONF/telegram.env" ] && [ ! -f "$CONF/settings.env" ] && mv "$CONF/telegram.env" "$CONF/settings.env"

# settings.env holds KEY=value lines; read as plain text, never sourced.
cfg() { sed -n "s/^$1=//p" "$CONF/settings.env" 2>/dev/null | tail -1; }
HEALTH_MIN=${HEALTH_MIN:-$(cfg HEALTH_MIN)}
[[ $HEALTH_MIN =~ ^[0-9]+$ ]] || HEALTH_MIN=95   # notify when pod health % drops below this

send() { # $1 urgency, $2 title, $3 body; prints one result line per target
  local text="$2
$3" r tok chat
  if [ "$(cfg NOTIFY_DESKTOP)" != 0 ]; then
    notify-send -a "Cluster Health" -u "$1" "$2" "$3" 2>/dev/null && echo "desktop: ok" || echo "desktop: failed"
  fi
  tok=$(cfg TG_TOKEN); chat=$(cfg TG_CHAT)
  if [ -n "$tok" ] && [ -n "$chat" ]; then
    r=$(curl -s -m 10 "https://api.telegram.org/bot$tok/sendMessage" --data-urlencode "chat_id=$chat" --data-urlencode "text=$text")
    [[ $r == *'"ok":true'* ]] && echo "telegram: ok" || echo "telegram: failed $(jq -r '.description // empty' <<<"$r" 2>/dev/null)"
  fi
  hook() { # name url json
    [ -n "$2" ] || return 0
    r=$(curl -s -m 10 -o /dev/null -w '%{http_code}' -H 'Content-Type: application/json' -d "$3" "$2")
    [[ $r == 2* ]] && echo "$1: ok" || echo "$1: failed (HTTP $r)"
  }
  hook slack "$(cfg SLACK_WEBHOOK)" "$(jq -n --arg t "$text" '{text: $t}')"
  hook mattermost "$(cfg MATTERMOST_WEBHOOK)" "$(jq -n --arg t "$text" '{text: $t}')"
  hook discord "$(cfg DISCORD_WEBHOOK)" "$(jq -n --arg t "$text" '{content: $t[:1990]}')"
}
KEYS="TG_TOKEN TG_CHAT SLACK_WEBHOOK MATTERMOST_WEBHOOK DISCORD_WEBHOOK HEALTH_MIN NOTIFY_DESKTOP MUTE_UNTIL"
set_cfg() { # KEY=VALUE lines on stdin; unknown keys are ignored
  local f="$CONF/settings.env" line k
  umask 077   # settings hold tokens; the temp file below must be private too
  touch "$f" && chmod 600 "$f"
  while IFS= read -r line; do
    k=${line%%=*}
    [[ " $KEYS " == *" $k "* ]] || continue
    { grep -v "^$k=" "$f"; printf '%s\n' "$line"; } > "$f.tmp" && mv "$f.tmp" "$f"
  done
}
muted_until() { # epoch seconds, 0 = not muted, -1 = muted until unmuted
  local m; m=$(cfg MUTE_UNTIL)
  if [ "$m" = forever ]; then echo -1
  elif [[ $m =~ ^[0-9]+$ ]] && [ "$m" -gt "$(date +%s)" ]; then echo "$m"
  else echo 0; fi
}

# Commands used by the KDE and GNOME settings UIs.
case "$1" in
  --test)
    send normal "✅ Cluster Health test" "Notifications are working."
    exit 0 ;;
  --get)
    touch "$CONF/settings.env"
    jq -n --rawfile c "$CONF/clusters" --rawfile s "$CONF/settings.env" --argjson m "$(muted_until)" \
      '{clusters: $c, muted_until: $m,
        settings: ([$s | split("\n")[] | capture("^(?<key>[A-Z_]+)=(?<value>.*)$")] | from_entries)}'
    exit 0 ;;
  --set) # --set KEY=VALUE ...   or   --set - (lines on stdin)
    shift
    if [ "$1" = - ]; then set_cfg; else printf '%s\n' "$@" | set_cfg; fi
    exit 0 ;;
  --clusters) # new clusters file on stdin
    cat > "$CONF/clusters.tmp" && mv "$CONF/clusters.tmp" "$CONF/clusters"
    exit 0 ;;
  --mute) # --mute <seconds|forever|off>
    case "$2" in
      off|0) v=0 ;;
      forever) v=forever ;;
      ''|*[!0-9]*) echo "usage: cluster-health --mute <seconds|forever|off>" >&2; exit 1 ;;
      *) v=$(( $(date +%s) + $2 )) ;;
    esac
    echo "MUTE_UNTIL=$v" | set_cfg
    # Reflect the new mute state in the widget right away.
    [ -f "$CACHE/status.json" ] && jq --argjson m "$(muted_until)" '.muted_until = $m' "$CACHE/status.json" > "$CACHE/status.json.tmp" \
      && mv "$CACHE/status.json.tmp" "$CACHE/status.json"
    exit 0 ;;
esac

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

check() { # $1 = kubeconfig, $2 = optional namespace/service:port of Alertmanager; writes $tmp/<name>.json
  local kc=$1 name d
  name=$(basename "${kc%.*}"); d="$tmp/$name"; mkdir -p "$d"
  k() { KUBECONFIG=$kc timeout 30 kubectl "$@" 2>/dev/null; }
  # get <file> <kubectl args>: one retry, writes null if both attempts fail.
  get() { local out=$1; shift
    { k "$@" > "$out" && [ -s "$out" ]; } || { sleep 2; k "$@" > "$out" && [ -s "$out" ]; } || echo null > "$out"; }
  # One retry so a single slow request is not reported as an outage.
  if [ "$(k get --raw /readyz)" != "ok" ] && { sleep 3; [ "$(k get --raw /readyz)" != "ok" ]; }; then
    jq -n --arg n "$name" '{name:$n, up:false, watchdog:null, alerts:[], events:[], nodes:{total:0,notready:[]}, pods:{total:0,healthy:0,pct:null,namespaces:[],recent:[]}}' > "$tmp/$name.json"
    return
  fi
  # Alertmanager: override from the clusters file, else discovered by label or name (non-headless first).
  local am=$2
  if [ -z "$am" ]; then
    get "$d/s" get svc -A -o json
    am=$(jq -r '[.items[]? | select(.metadata.labels["app.kubernetes.io/name"] == "alertmanager"
                or .metadata.labels["operated-alertmanager"] == "true" or .metadata.name == "alertmanager")]
           | sort_by(.spec.clusterIP == "None") | first // empty
           | "\(.metadata.namespace)/\(.metadata.name):\((.spec.ports | (map(select(.name | IN("web", "http-web", "http"))) | first) // .[0]).port)"' "$d/s")
  fi
  # watchdog: null = no Alertmanager found, false = Alertmanager found but Watchdog not firing or unreachable
  if [ -n "$am" ]; then
    local ns=${am%%/*} svc=${am#*/} port=9093
    [[ $svc == *:* ]] && port=${svc##*:} && svc=${svc%%:*}
    get "$d/a" get --raw "/api/v1/namespaces/$ns/services/$svc:$port/proxy/api/v2/alerts?active=true&silenced=false&inhibited=false"
  else
    echo null > "$d/a"
  fi
  get "$d/p" get pods -A -o json
  get "$d/e" get events -A --field-selector type=Warning -o json
  get "$d/n" get nodes -o json
  jq -n --arg n "$name" --arg am "$am" --slurpfile A "$d/a" --slurpfile P "$d/p" --slurpfile E "$d/e" --slurpfile N "$d/n" '
    $A[0] as $a | $P[0] as $p | $E[0] as $e | $N[0] as $nodes |
    def age: (now - (sub("\\.[0-9]+"; "") | fromdateiso8601)) | floor
      | if . < 3600 then "\(./60|floor)m" elif . < 86400 then "\(./3600|floor)h" else "\(./86400|floor)d" end;
    def ok: .status.phase == "Succeeded"
      or (.status.phase == "Running" and ([.status.containerStatuses[]?.ready] | all));
    def sev: {"critical":0,"warning":1}[.] // 2;
    ($p.items // []) as $items
    | ([$items[] | select(ok)] | length) as $healthy
    | {
      name: $n, up: true, alertmanager: $am,
      watchdog: (if $am != "" then ([$a[]? | select(.labels.alertname == "Watchdog")] | length > 0) else null end),
      alerts: ([$a[]? | select(.labels.alertname | IN("Watchdog","InfoInhibitor") | not)
               | {name: .labels.alertname, ns: (.labels.namespace // ""), severity: (.labels.severity // ""),
                  msg: (.annotations.summary // .annotations.description // "")}]
               | sort_by(.severity | sev)),
      events: ([($e.items // [])[] | . + {t: (.lastTimestamp // .eventTime // .metadata.creationTimestamp)}]
               | sort_by(.t) | reverse | .[:15]
               | map({ns: .metadata.namespace, obj: "\(.involvedObject.kind)/\(.involvedObject.name)",
                      reason: .reason, msg: (.message | split("\n")[0] | .[:200]), age: (.t | age)})),
      nodes: {
        total: ($nodes.items // [] | length),
        notready: [($nodes.items // [])[] | select([.status.conditions[]? | select(.type == "Ready" and .status == "True")] | length == 0) | .metadata.name]
      },
      pods: {
        total: ($items | length), healthy: $healthy,
        # null = pod list could not be fetched; never treated as 0% healthy
        pct: (if ($items | length) == 0 then null else $healthy * 100 / ($items | length) | floor end),
        namespaces: ([$items[].metadata.namespace] | unique),
        recent: ($items | sort_by(.metadata.creationTimestamp) | reverse
          | map((([.status.containerStatuses[]?.state | .waiting.reason // .terminated.reason // empty
                  | select(. != "Completed")] | first) // .status.reason
                 # A container that was OOMKilled in the last hour and restarted still counts as OOMKilled.
                 // ([.status.containerStatuses[]?.lastState.terminated | select(.reason == "OOMKilled")
                      | select((.finishedAt // "1970-01-01T00:00:00Z" | fromdateiso8601) > now - 3600)]
                     | if length > 0 then "OOMKilled" else empty end)
                 // "") as $reason
            | {ns: .metadata.namespace, name: .metadata.name, phase: .status.phase, ok: ok,
                 reason: $reason,
                 state: (if .status.phase == "Succeeded" then "done"
                         elif (.status.phase | IN("Failed","Unknown")) or ($reason | test("BackOff|Err|Error|OOM|Invalid")) then "bad"
                         elif ok then "ok" else "pending" end),
                 ready: "\([.status.containerStatuses[]? | select(.ready)] | length)/\(.spec.containers | length)",
                 restarts: ([.status.containerStatuses[]?.restartCount] | add // 0),
                 age: (.metadata.creationTimestamp | age)}))
      }
    }' > "$tmp/$name.json"
}

# clusters file: "<kubeconfig> [namespace/service:port of Alertmanager]" per line
while read -r kc am; do
  [ -n "$kc" ] && [ "${kc:0:1}" != "#" ] && check "${kc/#\~/$HOME}" "$am" &
done < "$CONF/clusters"
wait

jq -s --argjson m "$(muted_until)" '{updated: (now | todate), muted_until: $m, clusters: .}' "$tmp"/*.json > "$tmp/status"
cp "$tmp/status" "$CACHE/status.json.tmp" && mv "$CACHE/status.json.tmp" "$CACHE/status.json"

# Problems worth a notification. Lines must be stable between runs (no changing numbers), since
# notifications fire on lines that appear or disappear. Warnings stay in the UI only.
problems() { jq -r --argjson min "$HEALTH_MIN" '.clusters[] | .name as $c
  | (if .up then empty else "\($c): API unreachable" end),
    (if .watchdog == false then "\($c): Watchdog missing (alerting pipeline dead)" else empty end),
    (.alerts[] | select(.severity == "critical") | "\($c): \(.name) \(.ns) \(.msg)"),
    (.nodes.notready[]? | "\($c): node \(.) NotReady"),
    (if .up and .pods.pct != null and .pods.pct < $min then "\($c): pod health below \($min)%" else empty end),
    (.pods.recent[] | select(.reason | test("CrashLoopBackOff|OOMKilled")) | "\($c): \(.ns)/\(.name) \(.reason)")' | sort -u; }
problems < "$tmp/status" > "$tmp/problems"

# $CACHE/notified = problems last announced. The first run only records them, so installing
# does not send a burst. While muted it is left alone, so unmuting sends one catch-up diff.
if [ ! -f "$CACHE/notified" ]; then cp "$tmp/problems" "$CACHE/notified"; exit 0; fi
[ "$(muted_until)" != 0 ] && exit 0
fired=$(comm -13 "$CACHE/notified" "$tmp/problems")
resolved=$(comm -23 "$CACHE/notified" "$tmp/problems")
[ -n "$fired" ] && send critical "🔴 Cluster problem" "$fired" >/dev/null
[ -n "$resolved" ] && send normal "✅ Resolved" "$resolved" >/dev/null
cp "$tmp/problems" "$CACHE/notified"
exit 0
