#!/usr/bin/env bash
# Checks every cluster in ~/.config/kube-health/clusters and the CI pipeline of every repo in
# ~/.config/kube-health/repos, writes ~/.cache/kube-health/status.json and notifies
# (desktop, Telegram, Slack, Mattermost, Discord) on changes.
#   kube-health          run one check
#   kube-health --test   send a test message to every configured target
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/kube-health"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/kube-health"
mkdir -p "$CONF" "$CACHE"
[ -f "$CONF/clusters" ] || echo "${KUBECONFIG:-$HOME/.kube/config}" > "$CONF/clusters"
[ -f "$CONF/repos" ] || touch "$CONF/repos"
[ -f "$CONF/telegram.env" ] && [ ! -f "$CONF/settings.env" ] && mv "$CONF/telegram.env" "$CONF/settings.env"

# settings.env holds KEY=value lines; read as plain text, never sourced.
cfg() { sed -n "s/^$1=//p" "$CONF/settings.env" 2>/dev/null | tail -1; }
HEALTH_MIN=${HEALTH_MIN:-$(cfg HEALTH_MIN)}
[[ $HEALTH_MIN =~ ^[0-9]+$ ]] || HEALTH_MIN=95   # notify when pod health % drops below this
NODE_CPU_MAX=$(cfg NODE_CPU_MAX); [[ $NODE_CPU_MAX =~ ^[0-9]+$ ]] || NODE_CPU_MAX=90   # notify when a node's CPU % reaches this
NODE_MEM_MAX=$(cfg NODE_MEM_MAX); [[ $NODE_MEM_MAX =~ ^[0-9]+$ ]] || NODE_MEM_MAX=90   # notify when a node's RAM % reaches this
PIPE_HISTORY=$(cfg PIPE_HISTORY); [[ $PIPE_HISTORY =~ ^[0-9]+$ ]] && [ "$PIPE_HISTORY" -le 20 ] || PIPE_HISTORY=5   # recent runs per repo
PIPE_MRS=$(cfg PIPE_MRS)   # 0 hides open pull/merge requests

send() { # $1 urgency, $2 title, $3 body; prints one result line per target
  local text="$2
$3" r tok chat
  if [ "$(cfg NOTIFY_DESKTOP)" != 0 ]; then
    notify-send -a "Kube Health" -u "$1" "$2" "$3" 2>/dev/null && echo "desktop: ok" || echo "desktop: failed"
  fi
  tok=$(cfg TG_TOKEN); chat=$(cfg TG_CHAT)
  if [ -n "$tok" ] && [ -n "$chat" ]; then
    r=$(curl -s -m 10 "https://api.telegram.org/bot$tok/sendMessage" --data-urlencode "chat_id=$chat" --data-urlencode "text=$text")
    [[ $r == *'"ok":true'* ]] && echo "telegram: ok" || echo "telegram: failed $(jq -r '.description // empty' <<<"$r" 2>/dev/null)"
  fi
  hook() { # name url json
    [ -n "$2" ] || return 0
    r=$(curl -s -m 10 -o /dev/null -w '%{http_code}' -H 'Content-Type: application/json' -d "$3" "$2")
    [[ $r == 2* ]] && echo "$1: ok" || echo "$1: failed (HTTP $r)"
  }
  hook slack "$(cfg SLACK_WEBHOOK)" "$(jq -n --arg t "$text" '{text: $t}')"
  hook mattermost "$(cfg MATTERMOST_WEBHOOK)" "$(jq -n --arg t "$text" '{text: $t}')"
  hook discord "$(cfg DISCORD_WEBHOOK)" "$(jq -n --arg t "$text" '{content: $t[:1990]}')"
}
RULES="API WATCHDOG CRITICAL NODE_NOTREADY NODE_PRESSURE NODE_CPU NODE_MEM POD_HEALTH CRASHLOOP PIPELINES"
KEYS="TG_TOKEN TG_CHAT SLACK_WEBHOOK MATTERMOST_WEBHOOK DISCORD_WEBHOOK HEALTH_MIN NODE_CPU_MAX NODE_MEM_MAX PIPE_HISTORY PIPE_MRS NOTIFY_DESKTOP MUTE_UNTIL $(printf 'NOTIFY_%s ' $RULES)"
set_cfg() { # KEY=VALUE lines on stdin; unknown keys are ignored
  local f="$CONF/settings.env" line k
  umask 077   # settings hold tokens; the temp file below must be private too
  touch "$f" && chmod 600 "$f"
  while IFS= read -r line; do
    k=${line%%=*}
    [[ " $KEYS " == *" $k "* ]] || continue
    { grep -v "^$k=" "$f"; printf '%s\n' "$line"; } > "$f.tmp" && mv "$f.tmp" "$f"
  done
}
muted_until() { # epoch seconds, 0 = not muted, -1 = muted until unmuted
  local m; m=$(cfg MUTE_UNTIL)
  if [ "$m" = forever ]; then echo -1
  elif [[ $m =~ ^[0-9]+$ ]] && [ "$m" -gt "$(date +%s)" ]; then echo "$m"
  else echo 0; fi
}

# Commands used by the KDE and GNOME settings UIs.
case "$1" in
  --test)
    send normal "✅ Kube Health test" "Notifications are working."
    exit 0 ;;
  --get)
    touch "$CONF/settings.env"
    jq -n --rawfile c "$CONF/clusters" --rawfile r "$CONF/repos" --rawfile s "$CONF/settings.env" --argjson m "$(muted_until)" \
      '{clusters: $c, repos: [$r | split("\n")[] | select(length > 0)], muted_until: $m,
        settings: ([$s | split("\n")[] | capture("^(?<key>[A-Z_]+)=(?<value>.*)$")] | from_entries)}'
    exit 0 ;;
  --repos) # new repos file on stdin: github:owner/repo@branch or gitlab:[host/]group/project@branch
    cat > "$CONF/repos.tmp" && mv "$CONF/repos.tmp" "$CONF/repos"
    exit 0 ;;
  --list-repos) # every repo the gh and glab logins can see, most recently pushed first
    {
      if command -v gh >/dev/null; then
        for owner in "" $(timeout 20 gh api user/orgs -q '.[].login' 2>/dev/null); do
          timeout 30 gh repo list $owner --limit 300 --no-archived --json nameWithOwner,defaultBranchRef,pushedAt 2>/dev/null \
            | jq -c '.[] | select(.defaultBranchRef.name) | {id: "github:\(.nameWithOwner)@\(.defaultBranchRef.name)",
                     name: .nameWithOwner, source: "github", pushed: .pushedAt}'
        done
      fi
      if command -v glab >/dev/null; then
        timeout 30 glab api --paginate "projects?membership=true&archived=false&simple=true&per_page=100" 2>/dev/null \
          | jq -c '.[] | select(.default_branch) | {id: "gitlab:\(.path_with_namespace)@\(.default_branch)",
                   name: .path_with_namespace, source: "gitlab", pushed: .last_activity_at}'
      fi
    } | jq -s 'unique_by(.id) | sort_by(.pushed) | reverse'
    exit 0 ;;
  --set) # --set KEY=VALUE ...   or   --set - (lines on stdin)
    shift
    if [ "$1" = - ]; then set_cfg; else printf '%s\n' "$@" | set_cfg; fi
    exit 0 ;;
  --clusters) # new clusters file on stdin
    cat > "$CONF/clusters.tmp" && mv "$CONF/clusters.tmp" "$CONF/clusters"
    exit 0 ;;
  --mute) # --mute <seconds|forever|off>
    case "$2" in
      off|0) v=0 ;;
      forever) v=forever ;;
      ''|*[!0-9]*) echo "usage: kube-health --mute <seconds|forever|off>" >&2; exit 1 ;;
      *) v=$(( $(date +%s) + $2 )) ;;
    esac
    echo "MUTE_UNTIL=$v" | set_cfg
    # Reflect the new mute state in the widget right away.
    [ -f "$CACHE/status.json" ] && jq --argjson m "$(muted_until)" '.muted_until = $m' "$CACHE/status.json" > "$CACHE/status.json.tmp" \
      && mv "$CACHE/status.json.tmp" "$CACHE/status.json"
    exit 0 ;;
esac

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/c" "$tmp/p"

AGE='def age: (now - (sub("\\.[0-9]+"; "") | fromdateiso8601)) | floor
  | if . < 3600 then "\(./60|floor)m" elif . < 86400 then "\(./3600|floor)h" else "\(./86400|floor)d" end;'

# Pipeline statuses: passed, failed, running, pending, canceled, none (no pipelines), error (could not fetch).
# Any failure wins, then running, then pending; all canceled is canceled; otherwise passed.
COMBINE='def combine: . as $s
  | if any($s[]; . == "failed") then "failed" elif any($s[]; . == "running") then "running"
    elif any($s[]; . == "pending") then "pending" elif ($s | length) > 0 and all($s[]; . == "canceled") then "canceled"
    elif ($s | length) == 0 then "none" else "passed" end;'

pipeline() { # $1 = repo spec (github:owner/repo@branch, gitlab:[host/]path@branch), $2 = output file, $3 = 1 to include open PRs/MRs
  local spec=$1 out=$2 with_mrs=$3 kind=${1%%:*} rest=${1#*:} repo branch host path enc
  repo=${rest%@*}; branch=${rest##*@}; [ "$branch" = "$rest" ] && branch=""
  # last_finished drives notifications, so a running pipeline never counts as fixed.
  # history: the last PIPE_HISTORY commits on the branch; mrs: open pull/merge requests with their pipeline status.
  case $kind in
    github)
      # Busy repos run many workflows per commit, so fetch enough runs to cover PIPE_HISTORY commits.
      timeout 20 gh run list -R "$repo" ${branch:+-b "$branch"} -L 100 \
        --json status,conclusion,headSha,displayTitle,url,createdAt > "$out.raw" 2>/dev/null || echo null > "$out.raw"
      if [ "$with_mrs" = 1 ]; then
        timeout 20 gh pr list -R "$repo" --state open -L 20 \
          --json number,title,headRefName,url,author,updatedAt,statusCheckRollup > "$out.mrs" 2>/dev/null || echo null > "$out.mrs"
      else echo '[]' > "$out.mrs"; fi
      jq -n --arg id "$spec" --arg name "$repo" --arg b "$branch" --argjson n "$PIPE_HISTORY" \
        --slurpfile R "$out.raw" --slurpfile M "$out.mrs" "$AGE$COMBINE"'
        def norm: if .status != "completed" then (if .status | IN("queued","waiting","pending","requested") then "pending" else "running" end)
          elif .conclusion | IN("success","skipped","neutral") then "passed"
          elif .conclusion | IN("failure","timed_out","startup_failure") then "failed" else "canceled" end;
        # PR checks are CheckRuns (status + conclusion) or StatusContexts (state).
        def check: (.conclusion // .state // "") as $c | (.status // "") as $s
          | if $c | IN("FAILURE","ERROR","TIMED_OUT","STARTUP_FAILURE","ACTION_REQUIRED") then "failed"
            elif ($s | IN("IN_PROGRESS","QUEUED","PENDING","WAITING","REQUESTED")) or ($c | IN("PENDING","EXPECTED")) then "running"
            elif $c | IN("SUCCESS","SKIPPED","NEUTRAL") then "passed" elif $c == "CANCELLED" then "canceled" else "pending" end;
        # Runs grouped by commit, newest first.
        def commits: reduce .[] as $r ([]; if (map(.sha) | index($r.headSha)) != null
          then map(if .sha == $r.headSha then .runs += [$r] else . end) else . + [{sha: $r.headSha, runs: [$r]}] end);
        $R[0] as $runs | $M[0] as $prs
        | {id: $id, name: $name, branch: $b,
           mrs: [$prs[]? | {ref: "#\(.number)", title, branch: .headRefName, author: (.author.login // ""), url,
                            age: (.updatedAt | age), status: ([.statusCheckRollup[]? | check] | combine)}]} + (
          if $runs == null then {status: "error", history: []}
          elif ($runs | length) == 0 then {status: "none", history: []}
          else ($runs | commits) as $cs
            | ([$cs[] | select(any(.runs[]; .status == "completed"))][0]) as $fin
            | ($cs[:([$n, 1] | max)] | map({status: ([.runs[] | norm] | combine), sha: .sha[:7], title: .runs[0].displayTitle,
                                             url: .runs[0].url, age: (.runs[0].createdAt | age)})) as $h
            | $h[0] + {history: (if $n > 0 then $h[:$n] else [] end),
                       last_finished: (if $fin then [$fin.runs[] | select(.status == "completed") | norm] | combine else null end)}
          end)' > "$out" ;;
    gitlab)
      path=$repo
      # A first segment with a dot is a self-hosted GitLab host: gitlab:gitlab.example.com/group/project
      [[ ${repo%%/*} == *.* ]] && host=${repo%%/*} && path=${repo#*/}
      enc=$(jq -rn --arg p "$path" '$p | @uri')
      g() { timeout 20 glab api ${host:+--hostname "$host"} "$@" 2>/dev/null; }
      local ref; ref=$(jq -rn --arg b "$branch" '$b | @uri')
      g "projects/$enc/pipelines?ref=$ref&per_page=$(( PIPE_HISTORY > 1 ? PIPE_HISTORY : 1 ))" > "$out.cur" || echo null > "$out.cur"
      g "projects/$enc/pipelines?ref=$ref&per_page=1&scope=finished" > "$out.fin" || echo null > "$out.fin"
      g "projects/$enc/repository/commits?ref_name=$ref&per_page=50" > "$out.commits" || echo '[]' > "$out.commits"
      if [ "$with_mrs" = 1 ]; then
        g graphql -F p="$path" -f query='query($p: ID!) { project(fullPath: $p) { mergeRequests(state: opened, first: 20, sort: UPDATED_DESC) {
          nodes { iid title webUrl sourceBranch updatedAt author { username } headPipeline { status path } } } } }' > "$out.mrs" \
          || echo null > "$out.mrs"
      else echo null > "$out.mrs"; fi
      jq -n --arg id "$spec" --arg name "$path" --arg b "$branch" --argjson n "$PIPE_HISTORY" --arg web "https://${host:-gitlab.com}" \
        --slurpfile C "$out.cur" --slurpfile F "$out.fin" --slurpfile T "$out.commits" --slurpfile M "$out.mrs" "$AGE$COMBINE"'
        def norm: ascii_downcase | if . == "success" then "passed" elif . == "failed" then "failed" elif . == "running" then "running"
          elif . | IN("canceled","canceling","skipped") then "canceled" else "pending" end;
        $C[0] as $c | $F[0] as $f
        | ([$T[0][]? | {key: .id[:7], value: .title}] | from_entries) as $titles
        | ($c | if type == "array" then map({status: (.status | norm), sha: .sha[:7], title: ($titles[.sha[:7]] // ""),
                                             url: .web_url, age: (.created_at | age)}) else null end) as $h
        | {id: $id, name: $name, branch: $b,
           mrs: [$M[0].data.project.mergeRequests.nodes[]? | {ref: "!\(.iid)", title, branch: .sourceBranch,
                  author: (.author.username // ""), url: .webUrl, age: (.updatedAt | age),
                  status: (if .headPipeline then .headPipeline.status | norm else "none" end)}]} + (
          if $h == null then {status: "error", history: []}
          elif ($h | length) == 0 then {status: "none", history: []}
          else $h[0] + {history: (if $n > 0 then $h[:$n] else [] end),
                        last_finished: ($f[0].status? | if . then norm else null end)}
          end)' > "$out" ;;
    *)
      jq -n --arg id "$spec" '{id: $id, name: $id, branch: "", status: "error", history: [], mrs: []}' > "$out" ;;
  esac
}

check() { # $1 = kubeconfig, $2 = optional namespace/service:port of Alertmanager; writes $tmp/c/<name>.json
  local kc=$1 name d
  name=$(basename "${kc%.*}"); d="$tmp/$name"; mkdir -p "$d"
  k() { KUBECONFIG=$kc timeout 30 kubectl "$@" 2>/dev/null; }
  # get <file> <kubectl args>: one retry, writes null if both attempts fail.
  get() { local out=$1; shift
    { k "$@" > "$out" && [ -s "$out" ]; } || { sleep 2; k "$@" > "$out" && [ -s "$out" ]; } || echo null > "$out"; }
  # One retry so a single slow request is not reported as an outage.
  if [ "$(k get --raw /readyz)" != "ok" ] && { sleep 3; [ "$(k get --raw /readyz)" != "ok" ]; }; then
    jq -n --arg n "$name" '{name:$n, up:false, watchdog:null, alerts:[], events:[], nodes:{total:0,notready:[],list:[]}, pods:{total:0,healthy:0,pct:null,namespaces:[],recent:[]}}' > "$tmp/c/$name.json"
    return
  fi
  # Alertmanager: override from the clusters file, else discovered by label or name (non-headless first).
  local am=$2
  if [ -z "$am" ]; then
    get "$d/s" get svc -A -o json
    am=$(jq -r '[.items[]? | select(.metadata.labels["app.kubernetes.io/name"] == "alertmanager"
                or .metadata.labels["operated-alertmanager"] == "true" or .metadata.name == "alertmanager")]
           | sort_by(.spec.clusterIP == "None") | first // empty
           | "\(.metadata.namespace)/\(.metadata.name):\((.spec.ports | (map(select(.name | IN("web", "http-web", "http"))) | first) // .[0]).port)"' "$d/s")
  fi
  # watchdog: null = no Alertmanager found, false = Alertmanager found but Watchdog not firing or unreachable
  if [ -n "$am" ]; then
    local ns=${am%%/*} svc=${am#*/} port=9093
    [[ $svc == *:* ]] && port=${svc##*:} && svc=${svc%%:*}
    get "$d/a" get --raw "/api/v1/namespaces/$ns/services/$svc:$port/proxy/api/v2/alerts?active=true&silenced=false&inhibited=false"
  else
    echo null > "$d/a"
  fi
  get "$d/p" get pods -A -o json
  get "$d/e" get events -A --field-selector type=Warning -o json
  get "$d/n" get nodes -o json
  get "$d/m" get --raw /apis/metrics.k8s.io/v1beta1/nodes   # metrics-server; null if not installed
  jq -n --arg n "$name" --arg am "$am" --slurpfile A "$d/a" --slurpfile P "$d/p" --slurpfile E "$d/e" --slurpfile N "$d/n" \
    --slurpfile M "$d/m" '
    $A[0] as $a | $P[0] as $p | $E[0] as $e | $N[0] as $nodes |
    ([$M[0].items[]? | {key: .metadata.name, value: .usage}] | from_entries) as $usage |
    def cores: if endswith("n") then .[:-1] | tonumber / 1e9 elif endswith("u") then .[:-1] | tonumber / 1e6
      elif endswith("m") then .[:-1] | tonumber / 1000 else tonumber end;
    def bytes: capture("^(?<n>[0-9.]+)(?<u>[A-Za-z]*)$") | (.n | tonumber)
      * ({"": 1, "k": 1e3, "M": 1e6, "G": 1e9, "Ki": 1024, "Mi": 1048576, "Gi": 1073741824, "Ti": 1099511627776}[.u] // 1);
    def pct(used; total): if used == null or total == 0 then null else used * 100 / total | floor end;
    ([($p.items // [])[] | select(.status.phase | IN("Succeeded", "Failed") | not) | .spec.nodeName] | group_by(.)
      | map({key: .[0], value: length}) | from_entries) as $podsOn |
    def age: (now - (sub("\\.[0-9]+"; "") | fromdateiso8601)) | floor
      | if . < 3600 then "\(./60|floor)m" elif . < 86400 then "\(./3600|floor)h" else "\(./86400|floor)d" end;
    def ok: .status.phase == "Succeeded"
      or (.status.phase == "Running" and ([.status.containerStatuses[]?.ready] | all));
    def sev: {"critical":0,"warning":1}[.] // 2;
    ($p.items // []) as $items
    | ([$items[] | select(ok)] | length) as $healthy
    | {
      name: $n, up: true, alertmanager: $am,
      watchdog: (if $am != "" then ([$a[]? | select(.labels.alertname == "Watchdog")] | length > 0) else null end),
      alerts: ([$a[]? | select(.labels.alertname | IN("Watchdog","InfoInhibitor") | not)
               | {name: .labels.alertname, ns: (.labels.namespace // ""), severity: (.labels.severity // ""),
                  msg: (.annotations.summary // .annotations.description // "")}]
               | sort_by(.severity | sev)),
      events: ([($e.items // [])[] | . + {t: (.lastTimestamp // .eventTime // .metadata.creationTimestamp)}]
               | sort_by(.t) | reverse | .[:15]
               | map({ns: .metadata.namespace, obj: "\(.involvedObject.kind)/\(.involvedObject.name)",
                      reason: .reason, msg: (.message | split("\n")[0] | .[:200]), age: (.t | age)})),
      nodes: {
        total: ($nodes.items // [] | length),
        notready: [($nodes.items // [])[] | select([.status.conditions[]? | select(.type == "Ready" and .status == "True")] | length == 0) | .metadata.name],
        list: [($nodes.items // [])[] | .metadata.name as $nn | $usage[$nn] as $u
          | (.status.allocatable.cpu | cores) as $cpuT | (.status.allocatable.memory | bytes) as $memT
          | ($u.cpu | if . then cores else null end) as $cpuU | ($u.memory | if . then bytes else null end) as $memU
          | {name: $nn,
             pool: (.metadata.labels | .nodepool // .agentpool // .["eks.amazonaws.com/nodegroup"]
                    // .["cloud.google.com/gke-nodepool"] // .["karpenter.sh/nodepool"] // ""),
             ready: ([.status.conditions[]? | select(.type == "Ready" and .status == "True")] | length > 0),
             pressure: [.status.conditions[]? | select((.type | test("Pressure$")) and .status == "True") | .type],
             cpu_used: ($cpuU | if . then . * 100 | floor / 100 else null end), cpu_total: $cpuT, cpu_pct: pct($cpuU; $cpuT),
             mem_used: $memU, mem_total: $memT, mem_pct: pct($memU; $memT),
             pods: ($podsOn[$nn] // 0), pods_max: (.status.allocatable.pods | tonumber),
             age: (.metadata.creationTimestamp | age)}]
      },
      pods: {
        total: ($items | length), healthy: $healthy,
        # null = pod list could not be fetched; never treated as 0% healthy
        pct: (if ($items | length) == 0 then null else $healthy * 100 / ($items | length) | floor end),
        namespaces: ([$items[].metadata.namespace] | unique),
        recent: ($items | sort_by(.metadata.creationTimestamp) | reverse
          | map((([.status.containerStatuses[]?.state | .waiting.reason // .terminated.reason // empty
                  | select(. != "Completed")] | first) // .status.reason
                 # A container that was OOMKilled in the last hour and restarted still counts as OOMKilled.
                 // ([.status.containerStatuses[]?.lastState.terminated | select(.reason == "OOMKilled")
                      | select((.finishedAt // "1970-01-01T00:00:00Z" | fromdateiso8601) > now - 3600)]
                     | if length > 0 then "OOMKilled" else empty end)
                 // "") as $reason
            | {ns: .metadata.namespace, name: .metadata.name, phase: .status.phase, ok: ok,
                 reason: $reason,
                 state: (if .status.phase == "Succeeded" then "done"
                         elif (.status.phase | IN("Failed","Unknown")) or ($reason | test("BackOff|Err|Error|OOM|Invalid")) then "bad"
                         elif ok then "ok" else "pending" end),
                 ready: "\([.status.containerStatuses[]? | select(.ready)] | length)/\(.spec.containers | length)",
                 restarts: ([.status.containerStatuses[]?.restartCount] | add // 0),
                 age: (.metadata.creationTimestamp | age)}))
      }
    }' > "$tmp/c/$name.json"
}

# clusters file: "<kubeconfig> [namespace/service:port of Alertmanager]" per line
while read -r kc am; do
  [ -n "$kc" ] && [ "${kc:0:1}" != "#" ] && check "${kc/#\~/$HOME}" "$am" &
done < "$CONF/clusters"
i=0
declare -A seen   # open PRs/MRs are per repo, so fetch them only for the first tracked branch
while read -r spec; do
  [ -n "$spec" ] && [ "${spec:0:1}" != "#" ] || continue
  i=$((i + 1)); mrs=0
  [ "$PIPE_MRS" != 0 ] && [ -z "${seen[${spec%@*}]}" ] && mrs=1
  seen[${spec%@*}]=1
  pipeline "$spec" "$tmp/p/$(printf %03d $i)" "$mrs" &
done < "$CONF/repos"
wait

jq -n --argjson m "$(muted_until)" --argjson cpu "$NODE_CPU_MAX" --argjson mem "$NODE_MEM_MAX" --argjson health "$HEALTH_MIN" \
  --slurpfile c <(cat "$tmp"/c/*.json 2>/dev/null) --slurpfile p <(cat "$tmp"/p/[0-9][0-9][0-9] 2>/dev/null) \
  '{updated: (now | todate), muted_until: $m, thresholds: {node_cpu: $cpu, node_mem: $mem, health: $health},
    clusters: $c, pipelines: $p}' > "$tmp/status"
cp "$tmp/status" "$CACHE/status.json.tmp" && mv "$CACHE/status.json.tmp" "$CACHE/status.json"

# Problems worth a notification. Lines must be stable between runs (no changing numbers), since
# notifications fire on lines that appear or disappear. Warnings stay in the UI only.
# Node usage lines only clear 5 points below the threshold, so a node hovering at the limit does not flap.
# Each rule can be turned off with NOTIFY_<RULE>=0; all are on by default.
problems() { jq -r --argjson min "$HEALTH_MIN" --argjson cpumax "$NODE_CPU_MAX" --argjson memmax "$NODE_MEM_MAX" \
  --rawfile prev <(cat "$CACHE/notified" 2>/dev/null) --rawfile s <(cat "$CONF/settings.env" 2>/dev/null) '
  ($prev | split("\n")) as $was |
  ([$s | split("\n")[] | capture("^NOTIFY_(?<key>[A-Z_]+)=(?<value>.*)$")] | from_entries) as $flags |
  def on($rule): $flags[$rule] != "0";
  def over($line; $pct; $max): if $pct != null and ($pct >= $max or ($pct >= $max - 5 and ($was | index($line)))) then $line else empty end;
  (.clusters[] | .name as $c
    | (if on("API") and (.up | not) then "\($c): API unreachable" else empty end),
      (if on("WATCHDOG") and .watchdog == false then "\($c): Watchdog missing (alerting pipeline dead)" else empty end),
      (if on("CRITICAL") then .alerts[] | select(.severity == "critical") | "\($c): \(.name) \(.ns) \(.msg)" else empty end),
      (if on("NODE_NOTREADY") then .nodes.notready[]? | "\($c): node \(.) NotReady" else empty end),
      (.nodes.list[]? |
         (if on("NODE_PRESSURE") then .pressure[] as $p | "\($c): node \(.name) \($p)" else empty end),
         (if on("NODE_CPU") then over("\($c): node \(.name) CPU above \($cpumax)%"; .cpu_pct; $cpumax) else empty end),
         (if on("NODE_MEM") then over("\($c): node \(.name) RAM above \($memmax)%"; .mem_pct; $memmax) else empty end)),
      (if on("POD_HEALTH") and .up and .pods.pct != null and .pods.pct < $min then "\($c): pod health below \($min)%" else empty end),
      (if on("CRASHLOOP") then .pods.recent[] | select(.reason | test("CrashLoopBackOff|OOMKilled")) | "\($c): \(.ns)/\(.name) \(.reason)" else empty end)),
  (if on("PIPELINES") then .pipelines[]? | select(.last_finished == "failed") | "\(.name)@\(.branch): pipeline failed" else empty end)
  ' | sort -u; }
problems < "$tmp/status" > "$tmp/problems"

# $CACHE/notified = problems last announced. The first run only records them, so installing
# does not send a burst. While muted it is left alone, so unmuting sends one catch-up diff.
if [ ! -f "$CACHE/notified" ]; then cp "$tmp/problems" "$CACHE/notified"; exit 0; fi
[ "$(muted_until)" != 0 ] && exit 0
fired=$(comm -13 "$CACHE/notified" "$tmp/problems")
resolved=$(comm -23 "$CACHE/notified" "$tmp/problems")
[ -n "$fired" ] && send critical "🔴 Problem" "$fired" >/dev/null
[ -n "$resolved" ] && send normal "✅ Resolved" "$resolved" >/dev/null
cp "$tmp/problems" "$CACHE/notified"
exit 0
